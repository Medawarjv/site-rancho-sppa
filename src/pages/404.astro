---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";

const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent("Olá! Vim pelo site do Rancho SPPA e quero consultar a disponibilidade.")}`;
---

<Layout titulo={`Página não encontrada · ${site.nome}`} descricao="Essa página não existe. Volte ao início ou fale com a gente pelo WhatsApp.">
  <section class="flex min-h-[70vh] items-center bg-areia px-6 py-20">
    <div class="mx-auto max-w-lg text-center">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-terra">Erro 404</p>
      <h1 class="font-titulo text-4xl font-semibold text-mata-escura sm:text-5xl">
        Essa trilha não leva a lugar nenhum
      </h1>
      <p class="mt-4 leading-relaxed text-tinta/80">
        A página que você procurou não existe ou mudou de endereço. O rancho continua
        no mesmo lugar, à beira da Represa de Miranda.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="inline-block rounded-full bg-mata px-7 py-3.5 font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-mata-escura"
        >
          Voltar ao início
        </a>
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="inline-block rounded-full border border-mata/30 px-7 py-3.5 font-medium text-mata transition hover:bg-mata/10"
        >
          Falar no WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
