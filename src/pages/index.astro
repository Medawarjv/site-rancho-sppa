---
import QRCode from "qrcode";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import site from "../data/site.json";
import heroImg from "../assets/hero-video.jpg";
import piscinaImg from "../assets/bloco-piscina.jpg";
import quiosqueImg from "../assets/bloco-quiosque.jpg";
import acomodacoesImg from "../assets/bloco-acomodacoes.jpg";
import esportesImg from "../assets/bloco-esportes.jpg";
import naturezaImg from "../assets/bloco-natureza.jpg";
import represaImg from "../assets/bloco-represa.jpg";
import Galeria from "../components/Galeria.astro";
import VideoRancho from "../components/VideoRancho.astro";
import Calendario from "../components/Calendario.astro";
import Regras from "../components/Regras.astro";
import ComoChegar from "../components/ComoChegar.astro";
import Avaliacoes from "../components/Avaliacoes.astro";
import Comodidades from "../components/Comodidades.astro";
import BarraFatos from "../components/BarraFatos.astro";
import ParaQuem from "../components/ParaQuem.astro";
import TituloSecao from "../components/TituloSecao.astro";
import Icon from "../components/Icon.astro";
import avaliacoes from "../data/avaliacoes.json";

// WhatsApp com mensagem contextual por seção (a mensagem NÃO é enviada
// sozinha — o usuário confirma; só já dá o contexto pro atendimento).
const wa = (msg: string) =>
  `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(msg)}`;
// QR code do CTA final (só desktop): quem está no computador sem WhatsApp conectado
// aponta a câmera do celular e cai direto na conversa. Gerado no build, sem JS no cliente.
// Mensagem curta de propósito: quanto menor a URL, mais fácil de ler o QR.
const qrSvg = await QRCode.toString(wa("Olá! Vim pelo site do Rancho SPPA."), {
  type: "svg",
  margin: 1,
  errorCorrectionLevel: "M",
  color: { dark: "#1e3f27", light: "#ffffff" },
});
const waFinal = wa(
  "Olá! Quero marcar uma data no Rancho SPPA. Pode me passar a disponibilidade e os valores?",
);

// Dados estruturados para o Google (rich results).
const schema = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "@id": "https://ranchopicapaumg.com.br/#lodging",
  name: site.nome,
  alternateName: site.nomeCompleto,
  description:
    "Rancho para aluguel por temporada às margens da Represa de Miranda, em Indianópolis-MG, a menos de 1 hora de Uberlândia. Piscina aquecida, 10 suítes para até 30 pessoas, quiosque com churrasqueira, esportes e natureza.",
  url: "https://ranchopicapaumg.com.br",
  image: ["https://ranchopicapaumg.com.br/og.jpg"],
  telephone: `+${site.whatsapp}`,
  hasMap: site.mapsLink,
  numberOfRooms: 10,
  petsAllowed: true,
  paymentAccepted: "PIX, Dinheiro",
  areaServed: ["Indianópolis", "Uberlândia", "Triângulo Mineiro"],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Indianópolis",
    addressRegion: "MG",
    postalCode: "38490-000",
    addressCountry: "BR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: Number(site.mapsLat),
    longitude: Number(site.mapsLng),
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.7",
    reviewCount: "68",
    bestRating: "5",
  },
  amenityFeature: [
    "Piscina aquecida por energia solar",
    "Quiosque com churrasqueira e forno de pizza",
    "10 suítes com ar-condicionado",
    "Wi-Fi",
    "Acesso à Represa de Miranda com píer",
    "Quadra de beach tennis",
    "Trilhas e cachoeiras",
    "Pet friendly",
  ].map((nome) => ({
    "@type": "LocationFeatureSpecification",
    name: nome,
    value: true,
  })),
  sameAs: [site.mapsLink, site.instagram, site.facebook].filter(Boolean),
};

// Os 6 blocos do rancho (escopo §4.2). Texto adaptado do material aprovado.
const blocos = [
  {
    img: piscinaImg,
    alt: "Piscina azul com deck de pedra entre coqueiros, ao lado do quiosque",
    titulo: "Piscina aquecida",
    texto:
      "Piscina aquecida por energia solar, para curtir a água com conforto em qualquer época do ano.",
  },
  {
    img: quiosqueImg,
    alt: "Quiosque coberto com rede, mesas, sofás e sinuca",
    titulo: "Área gourmet e quiosque",
    texto:
      "Quiosque com churrasqueira, fogão a lenha e forno de pizza, além de cozinha industrial completa, gás e água potável. O ponto de encontro para reunir a família toda.",
  },
  {
    img: acomodacoesImg,
    alt: "Suíte em madeira com cama de casal, TV e ar-condicionado",
    titulo: "Acomodações",
    texto:
      "10 suítes com ar-condicionado. Algumas, além da cama de casal, têm camas de solteiro para acomodar até 30 pessoas. Wi-Fi Starlink e fibra ótica.",
  },
  {
    img: esportesImg,
    alt: "Quadra de areia com playground e piscina ao lado",
    titulo: "Esportes & lazer",
    texto:
      "Campo de futebol, quadra de areia para beach tennis, peteca ou vôlei, caiaques, bicicletas, sinuca, ping-pong, dardos, cartas e playground.",
  },
  {
    img: naturezaImg,
    alt: "Cachoeira em meio à mata do rancho",
    titulo: "Natureza",
    texto:
      "70.000 m² de área verde com trilhas, pomar, nascente, riacho e cachoeiras para explorar com calma.",
  },
  {
    img: represaImg,
    alt: "Píer do rancho na Represa de Miranda, visto do alto",
    titulo: "Represa de Miranda",
    texto:
      "430 metros de margem, com píer, tablado de pesca e redutor para descer/subir lancha de até 1 tonelada na represa.",
  },
];

---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- HERO (full-bleed) -->
  <header
    id="hero"
    class="relative flex items-end overflow-hidden bg-mata-escura sm:min-h-[90vh]"
  >
    <!--
      VÍDEO EM LOOP (12 s, sem som, trechos do vídeo institucional).
      Celular: o vídeo fica livre no topo (sem texto por cima) e o texto vem embaixo, no verde.
      Desktop: full-bleed. A foto embaixo é o 1º quadro do loop: aparece na hora (é o LCP)
      e o vídeo entra por cima com fade quando começa a tocar. Quem está em economia de dados
      fica só com a foto. Não dá pra depender de prefers-reduced-motion: o Windows liga isso
      sozinho quando as animações do sistema estão desligadas (comum em PC de escritório), e o
      vídeo ficaria parado pra muita gente. Em vez disso há o botão de pausar (WCAG 2.2.2).
    -->
    <div class="absolute inset-x-0 top-0 h-[88vw] overflow-hidden sm:inset-0 sm:h-auto">
      <Image
        src={heroImg}
        alt="Vista aérea do Rancho SPPA às margens da Represa de Miranda, ao amanhecer"
        class="absolute inset-0 h-full w-full object-cover"
        widths={[768, 1280]}
        quality={72}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <video
        id="hero-video"
        class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        data-src-celular="/video/hero-loop-720.mp4"
        data-src-desktop="/video/hero-loop-1080.mp4"
      ></video>
      <button
        id="hero-pausa"
        type="button"
        aria-label="Pausar vídeo de fundo"
        class="absolute bottom-3 right-3 z-20 hidden h-9 w-9 items-center justify-center rounded-full bg-black/35 text-white/90 backdrop-blur-sm transition hover:bg-black/55 sm:bottom-6 sm:right-6"
      >
        <svg data-icone="pausa" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
        <svg data-icone="play" viewBox="0 0 24 24" class="hidden h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
      </button>
      <!-- celular: funde a base da foto no verde do bloco de texto -->
      <div class="absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-mata-escura to-transparent sm:hidden"></div>
      <!-- desktop: escurece só a LATERAL do texto; a direita (piscina) fica clara -->
      <div class="absolute inset-0 hidden bg-gradient-to-r from-black/75 via-black/45 via-45% to-transparent to-80% sm:block"></div>
      <div class="absolute inset-x-0 bottom-0 hidden h-1/4 bg-gradient-to-t from-black/30 to-transparent sm:block"></div>
      <!-- scrim do topo: fundo escuro atrás da marca -->
      <div class="absolute inset-x-0 top-0 h-[30%] bg-gradient-to-b from-black/50 to-transparent sm:from-black/30"></div>
    </div>

    <!-- Marca (wordmark tipográfico, mesma estrutura do logo oficial) -->
    <a
      href="/"
      aria-label="Rancho Pica-Pau MG, desde 2001. Voltar ao início"
      class="absolute inset-x-0 top-[calc(1.25rem+env(safe-area-inset-top))] z-20 mx-auto flex w-fit flex-col items-center [filter:drop-shadow(0_1px_1px_rgba(0,0,0,0.6))_drop-shadow(0_2px_10px_rgba(0,0,0,0.5))] sm:inset-x-auto sm:left-8 sm:top-[calc(1.75rem+env(safe-area-inset-top))] sm:mx-0 sm:items-start"
    >
      <span class="font-marca text-[1.75rem] uppercase leading-none tracking-wide text-white sm:text-4xl lg:text-5xl">
        Rancho <span class="text-dourado">Pica-Pau</span> MG
      </span>
      <span class="mt-1.5 flex items-center gap-2 self-stretch text-[11px] font-semibold uppercase tracking-[0.35em] text-white sm:font-medium lg:text-xs">
        <span class="h-px flex-1 bg-white/80"></span>
        Desde 2001
        <span class="h-px flex-1 bg-white/80"></span>
      </span>
    </a>

    <!-- celular: o texto começa logo abaixo da foto (88vw). Desktop: pt reserva espaço pra marca -->
    <div class="relative z-10 mx-auto w-full max-w-6xl px-6 pb-12 pt-[calc(88vw+0.5rem)] sm:pb-20 sm:pt-32">
      <div class="max-w-2xl text-white">
        <h1 class="font-titulo text-4xl font-semibold leading-[1.05] drop-shadow-md sm:text-6xl xl:text-7xl">
          Seu refúgio na Represa de Miranda
        </h1>
        <p class="mt-5 max-w-xl text-lg text-white/90 drop-shadow sm:text-xl">
          Rancho para aluguel por temporada em Indianópolis-MG, a menos de
          1&nbsp;hora de Uberlândia. Natureza, água e estrutura completa para o sossego de toda a família.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#disponibilidade"
            class="inline-block rounded-full bg-zap px-8 py-4 text-base font-semibold text-white shadow-xl transition hover:-translate-y-0.5 hover:bg-zap-escuro"
          >
            Consultar disponibilidade
          </a>
          <a
            href="#video"
            class="inline-flex items-center gap-2 rounded-full border border-white/50 px-7 py-4 text-base font-medium text-white backdrop-blur-sm transition hover:bg-white/10"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            Ver o vídeo
          </a>
        </div>

        <!-- Prova social -->
        <p class="mt-7 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-white/85">
          <span class="flex text-dourado">
            {[0, 1, 2, 3, 4].map(() => <Icon name="star" class="h-4 w-4" />)}
          </span>
          <span>
            <strong>{avaliacoes.resumo.nota}</strong> · {avaliacoes.resumo.total} avaliações no Google
          </span>
        </p>

        <!-- Localização (abaixo da prova social, longe da marca no mobile) -->
        <p class="mt-5 flex items-center gap-3 text-xs font-medium uppercase tracking-[0.2em] text-white/85">
          <span class="h-px w-8 bg-dourado"></span>
          Indianópolis · MG · Represa de Miranda
        </p>
      </div>
    </div>
  </header>

  <!-- BARRA DE FATOS -->
  <BarraFatos />

  <!-- VÍDEO INSTITUCIONAL -->
  <VideoRancho />

  <!-- O RANCHO — 6 blocos -->
  <section id="rancho" class="bg-areia py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-6">
    <TituloSecao
      kicker="A estrutura"
      titulo="Tudo que o rancho oferece"
      sub="70.000 m² de estrutura completa para descansar, se divertir e curtir a represa com quem você ama."
    />

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        blocos.map((b) => (
          <article class="group overflow-hidden rounded-2xl bg-white ring-1 ring-terra/10 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-[0_18px_40px_-18px_rgba(30,63,39,0.35)]">
            <div class="overflow-hidden">
              <Image
                src={b.img}
                alt={b.alt}
                class="h-56 w-full object-cover transition duration-500 group-hover:scale-105"
                widths={[400, 640, 800]}
                sizes="(min-width: 1024px) 352px, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="font-titulo text-xl font-semibold text-mata-escura">{b.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-tinta/70">{b.texto}</p>
            </div>
          </article>
        ))
      }
    </div>
    </div>
  </section>

  <!-- GALERIA -->
  <Galeria />

  <!-- PARA QUEM É (3 perfis com CTA contextual) -->
  <ParaQuem />

  <!-- DISPONIBILIDADE (calendário via iCal) -->
  <Calendario />

  <!-- REGRAS PRINCIPAIS -->
  <Regras />

  <!-- COMO CHEGAR (mapa) -->
  <ComoChegar />

  <!-- COMODIDADES E PARCEIROS -->
  <Comodidades />

  <!-- PROVA SOCIAL -->
  <Avaliacoes />

  <!-- CTA FINAL -->
  <section id="contato" class="bg-mata px-6 py-20 text-center text-areia sm:py-24">
    <h2 class="font-titulo text-3xl font-bold sm:text-4xl">
      Bora marcar a sua data?
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-areia/85">
      Nosso atendimento responde rapidinho no WhatsApp: tira dúvidas, confirma
      disponibilidade e passa os valores. Sem compromisso.
    </p>
    <a
      href={waFinal}
      target="_blank"
      rel="noopener"
      class="mt-8 inline-block rounded-full bg-zap px-8 py-4 text-lg font-semibold text-white shadow-xl transition hover:scale-105 hover:bg-zap-escuro"
    >
      Consultar disponibilidade
    </a>

    <!-- Número por extenso: pra quem prefere salvar o contato ou chamar pelo celular -->
    <p class="mt-5 text-sm text-areia/85">
      Ou chame no WhatsApp:
      <a href={waFinal} target="_blank" rel="noopener" class="whitespace-nowrap font-semibold text-areia underline-offset-4 hover:underline">{site.whatsappExibicao}</a>
    </p>

    <!-- QR code: só em tela grande (no celular o botão já abre o app) -->
    <div class="mx-auto mt-8 hidden w-fit items-center gap-5 rounded-2xl bg-white/10 p-4 pr-6 text-left ring-1 ring-white/15 lg:flex">
      <div
        class="h-28 w-28 shrink-0 overflow-hidden rounded-lg bg-white p-1 [&>svg]:h-full [&>svg]:w-full"
        role="img"
        aria-label="QR code para abrir a conversa com o Rancho SPPA no WhatsApp"
        set:html={qrSvg}
      />
      <p class="max-w-[15rem] text-sm leading-relaxed text-areia/90">
        <strong class="block font-semibold text-areia">Está no computador?</strong>
        Aponte a câmera do celular para o código e a conversa abre direto no WhatsApp.
      </p>
    </div>

    <!-- Prova social junto do botão final -->
    <p class="mt-6 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm text-areia/80">
      <span class="flex text-dourado" aria-hidden="true">
        {[0, 1, 2, 3, 4].map(() => <Icon name="star" class="h-4 w-4" />)}
      </span>
      <span>
        <strong class="text-areia">{avaliacoes.resumo.nota}</strong> · {avaliacoes.resumo.total} avaliações no Google
      </span>
    </p>
  </section>

</Layout>

<script>
  // Hero: baixa e toca o loop, exceto pra quem está em economia de dados.
  const hv = document.getElementById("hero-video") as HTMLVideoElement | null;
  const pausa = document.getElementById("hero-pausa");
  const conn = (navigator as any).connection;
  const pouparDados = conn?.saveData || /(^|-)2g$/.test(conn?.effectiveType ?? "");
  if (hv && pausa && !pouparDados) {
    // Mais de 1400 px reais de largura (computador): 1080p (~8 MB). Celular: 720p (~4 MB).
    const grande = window.innerWidth * Math.min(window.devicePixelRatio || 1, 2) > 1400;
    hv.src = grande ? hv.dataset.srcDesktop! : hv.dataset.srcCelular!;
    hv.addEventListener(
      "playing",
      () => {
        hv.classList.remove("opacity-0");
        pausa.classList.replace("hidden", "flex");
      },
      { once: true },
    );
    hv.play().catch(() => {});
    pausa.addEventListener("click", () => {
      const tocar = hv.paused;
      if (tocar) hv.play().catch(() => {});
      else hv.pause();
      pausa.setAttribute("aria-label", tocar ? "Pausar vídeo de fundo" : "Tocar vídeo de fundo");
      pausa.querySelector('[data-icone="pausa"]')!.classList.toggle("hidden", !tocar);
      pausa.querySelector('[data-icone="play"]')!.classList.toggle("hidden", tocar);
    });
  }
</script>
