---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import site from "../data/site.json";
import heroImg from "../assets/hero.jpg";
import piscinaImg from "../assets/bloco-piscina.jpg";
import quiosqueImg from "../assets/bloco-quiosque.jpg";
import acomodacoesImg from "../assets/bloco-acomodacoes.jpg";
import esportesImg from "../assets/bloco-esportes.jpg";
import naturezaImg from "../assets/bloco-natureza.jpg";
import represaImg from "../assets/bloco-represa.jpg";
import Galeria from "../components/Galeria.astro";
import Calendario from "../components/Calendario.astro";
import Regras from "../components/Regras.astro";
import ComoChegar from "../components/ComoChegar.astro";
import Avaliacoes from "../components/Avaliacoes.astro";
import Comodidades from "../components/Comodidades.astro";
import BarraFatos from "../components/BarraFatos.astro";
import Icon from "../components/Icon.astro";
import avaliacoes from "../data/avaliacoes.json";

// WhatsApp com mensagem contextual por seção (a mensagem NÃO é enviada
// sozinha — o usuário confirma; só já dá o contexto pra Lorena).
const wa = (msg: string) =>
  `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(msg)}`;
const waHero = wa("Olá! Vi o site do Rancho SPPA e quero consultar a disponibilidade.");
const waFinal = wa(
  "Olá! Quero marcar uma data no Rancho SPPA. Pode me passar a disponibilidade e os valores?",
);

// Dados estruturados para o Google (rich results).
const schema = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  name: site.nome,
  alternateName: site.nomeCompleto,
  description:
    "Rancho para aluguel por temporada às margens da Represa de Miranda, em Indianópolis-MG, a cerca de 1 hora de Uberlândia.",
  url: "https://sppa.com.br",
  image: "https://sppa.com.br/og.jpg",
  telephone: `+${site.whatsapp}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Indianópolis",
    addressRegion: "MG",
    postalCode: "38490-000",
    addressCountry: "BR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: Number(site.mapsLat),
    longitude: Number(site.mapsLng),
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.7",
    reviewCount: "68",
    bestRating: "5",
  },
  amenityFeature: [
    "Piscina aquecida",
    "Churrasqueira e forno de pizza",
    "Wi-Fi",
    "Acesso à represa e píer",
    "Quadra de beach tennis",
    "Pet friendly",
  ].map((nome) => ({
    "@type": "LocationFeatureSpecification",
    name: nome,
    value: true,
  })),
  sameAs: [site.mapsLink],
};

// Os 6 blocos do rancho (escopo §4.2). Texto adaptado do material aprovado.
const blocos = [
  {
    img: piscinaImg,
    alt: "Piscina azul do Rancho SPPA entre coqueiros, em dia de sol",
    titulo: "Piscina aquecida",
    texto:
      "Piscina aquecida por energia solar, para curtir a água com conforto em qualquer época do ano.",
  },
  {
    img: quiosqueImg,
    alt: "Quiosque com churrasqueira e forno de pizza",
    titulo: "Quiosque & churrasqueira",
    texto:
      "Quiosque com churrasqueira, fogão a lenha e forno de pizza — o ponto de encontro para reunir a família toda.",
  },
  {
    img: acomodacoesImg,
    alt: "Suíte com cama de casal e ar-condicionado",
    titulo: "Acomodações",
    texto:
      "10 suítes com ar-condicionado e cama de casal. As maiores têm camas de solteiro ou beliches, acomodando até 30 pessoas. Cozinha equipada, Wi-Fi, gás e água potável.",
  },
  {
    img: esportesImg,
    alt: "Quadra de areia e playground do rancho em dia de sol",
    titulo: "Esportes & lazer",
    texto:
      "Campo de futebol, quadra de areia para beach tennis, peteca ou vôlei, além de sinuca, ping-pong e playground.",
  },
  {
    img: naturezaImg,
    alt: "Riacho e cachoeira em meio à mata do rancho",
    titulo: "Natureza",
    texto:
      "70.000 m² de área verde com trilhas, pomar, riacho e cachoeiras para explorar sem pressa.",
  },
  {
    img: represaImg,
    alt: "Píer do rancho às margens da Represa de Miranda",
    titulo: "Represa de Miranda",
    texto:
      "450 metros de margem, com píer, tablado de pesca e redutor para descer lancha ou jet ski de até 1 tonelada.",
  },
];

---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- HERO -->
  <header
    id="hero"
    class="relative flex min-h-[88vh] items-center justify-center overflow-hidden"
  >
    <Image
      src={heroImg}
      alt="Represa de Miranda em dia de sol, vista do píer do Rancho SPPA"
      class="absolute inset-0 h-full w-full object-cover"
      widths={[768, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <!-- escurece a foto pra leitura do texto -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/45 via-black/25 to-black/65"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-2xl px-6 text-center text-white">
      <p class="mb-3 text-sm font-medium tracking-widest uppercase drop-shadow">
        {site.local}
      </p>
      <h1
        class="font-titulo text-4xl font-bold leading-tight drop-shadow-lg sm:text-6xl"
      >
        Seu refúgio na Represa de Miranda
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-white/90 drop-shadow sm:text-xl">
        Rancho para aluguel por temporada em Indianópolis-MG, a cerca de 1&nbsp;hora
        de Uberlândia. Natureza, água e sossego para a família toda.
      </p>
      <a
        href={waHero}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-block rounded-full bg-[#25D366] px-8 py-4 text-lg font-semibold text-white shadow-xl transition hover:scale-105 hover:bg-[#1ebe57]"
      >
        Consultar disponibilidade
      </a>

      <!-- Prova social no primeiro dobra -->
      <p class="mt-6 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm text-white/90 drop-shadow">
        <span class="flex text-yellow-400">
          {[0, 1, 2, 3, 4].map(() => <Icon name="star" class="h-4 w-4" />)}
        </span>
        <span><strong>{avaliacoes.resumo.nota}</strong> · {avaliacoes.resumo.total} avaliações no Google</span>
        <span class="opacity-70">· Recebendo famílias desde 2001</span>
      </p>
    </div>
  </header>

  <!-- BARRA DE FATOS -->
  <BarraFatos />

  <!-- O RANCHO — 6 blocos -->
  <section id="rancho" class="bg-areia py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <h2 class="font-titulo text-3xl font-bold text-mata sm:text-4xl">
        O rancho
      </h2>
      <p class="mt-3 text-terra">
        7 hectares de estrutura completa para descansar, se divertir e curtir a
        represa com quem você ama.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        blocos.map((b) => (
          <article class="overflow-hidden rounded-2xl bg-white shadow-md transition hover:shadow-xl">
            <Image
              src={b.img}
              alt={b.alt}
              class="h-56 w-full object-cover"
              width={800}
              loading="lazy"
            />
            <div class="p-6">
              <h3 class="font-titulo text-xl font-bold text-mata">{b.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-terra">{b.texto}</p>
            </div>
          </article>
        ))
      }
    </div>
    </div>
  </section>

  <!-- GALERIA -->
  <Galeria />

  <!-- DISPONIBILIDADE (calendário via iCal) -->
  <Calendario />

  <!-- REGRAS PRINCIPAIS -->
  <Regras />

  <!-- COMO CHEGAR (mapa) -->
  <ComoChegar />

  <!-- COMODIDADES E PARCEIROS -->
  <Comodidades />

  <!-- PROVA SOCIAL -->
  <Avaliacoes />

  <!-- CTA FINAL -->
  <section id="contato" class="bg-mata px-6 py-20 text-center text-areia sm:py-24">
    <h2 class="font-titulo text-3xl font-bold sm:text-4xl">
      Bora marcar a sua data?
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-areia/85">
      A Lorena responde rapidinho no WhatsApp: tira dúvidas, confirma
      disponibilidade e passa os valores. Sem compromisso.
    </p>
    <a
      href={waFinal}
      target="_blank"
      rel="noopener"
      class="mt-8 inline-block rounded-full bg-[#25D366] px-8 py-4 text-lg font-semibold text-white shadow-xl transition hover:scale-105 hover:bg-[#1ebe57]"
    >
      Consultar disponibilidade
    </a>
  </section>

</Layout>
