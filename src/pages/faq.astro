---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import faq from "../data/faq.json";

const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMensagem)}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.p,
    acceptedAnswer: { "@type": "Answer", text: item.r },
  })),
};
---

<Layout
  titulo={`Perguntas frequentes — ${site.nome}`}
  descricao="Tire suas dúvidas sobre o Rancho SPPA: valores, reservas, cancelamento, horários, o que está incluso, pets e como chegar."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
    <a href="/" class="text-sm font-medium text-agua hover:text-mata">← Voltar ao site</a>

    <h1 class="mt-6 font-titulo text-4xl font-bold text-mata">
      Perguntas frequentes
    </h1>
    <p class="mt-3 text-terra">
      As dúvidas mais comuns de quem vem ao rancho. Qualquer outra coisa, é só
      chamar no WhatsApp.
    </p>

    <div class="mt-10 divide-y divide-terra/15 border-y border-terra/15">
      {
        faq.map((item) => (
          <details class="group py-2">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold text-mata marker:content-none">
              {item.p}
              <span
                class="shrink-0 text-2xl text-terra/50 transition group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="pb-4 leading-relaxed text-terra">{item.r}</p>
          </details>
        ))
      }
    </div>

    <div class="mt-12 rounded-2xl bg-mata p-8 text-center text-areia">
      <p class="text-lg font-semibold">Ainda com dúvidas?</p>
      <a
        href={waHref}
        target="_blank"
        rel="noopener"
        class="mt-5 inline-block rounded-full bg-[#25D366] px-8 py-4 font-semibold text-white shadow-lg transition hover:scale-105 hover:bg-[#1ebe57]"
      >
        Falar no WhatsApp
      </a>
    </div>
  </main>
</Layout>
