---
import "../styles/global.css";
import site from "../data/site.json";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import Icon from "../components/Icon.astro";

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string;
}

const {
  titulo = `${site.nome} — Aluguel por temporada · Represa de Miranda, MG`,
  descricao = "Rancho para aluguel por temporada às margens da Represa de Miranda, em Indianópolis-MG, a ~1h de Uberlândia. Piscina aquecida, 10 suítes até 30 pessoas, quiosque, esportes e natureza.",
  imagem = "/og.jpg",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImagem = new URL(imagem, Astro.site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Tipografia: Fraunces (títulos) + Inter (corpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#2f5d3a" />
    <link rel="canonical" href={canonical} />

    <title>{titulo}</title>
    <meta name="description" content={descricao} />

    <!-- Open Graph (WhatsApp, Facebook, Instagram) -->
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagem} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content="Área de lazer do Rancho SPPA à beira da Represa de Miranda" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={ogImagem} />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="text-mata-escura antialiased">
    <slot />

    <footer class="bg-mata-escura py-12 text-center text-sm text-areia/70">
      {
        site.instagram && (
          <a
            href={site.instagram}
            target="_blank"
            rel="noopener"
            aria-label="Instagram do Rancho SPPA"
            class="mb-6 inline-flex items-center gap-2 rounded-full border border-areia/20 px-5 py-2 font-medium text-areia transition hover:border-dourado hover:text-dourado"
          >
            <Icon name="instagram" class="h-5 w-5" />
            @ranchopicapaumg
          </a>
        )
      }
      <nav class="mb-4 flex flex-wrap justify-center gap-x-6 gap-y-2">
        <a href="/" class="hover:text-areia">Início</a>
        <a href="/faq" class="hover:text-areia">Perguntas frequentes</a>
        <a href="/politicas" class="hover:text-areia">Políticas e regras</a>
      </nav>
      <p>{site.nomeCompleto} · {site.local}</p>
      <p class="mt-1">Desde 2001 · Aluguel por temporada</p>
    </footer>

    <WhatsAppFloat />
  </body>
</html>
