---
import "../styles/global.css";
import site from "../data/site.json";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import Icon from "../components/Icon.astro";
// Pré-carrega as duas fontes que aparecem acima da dobra (título e corpo).
import fonteTituloUrl from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import fonteCorpoUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string;
}

const {
  titulo = `${site.nome} · Aluguel por temporada na Represa de Miranda, MG`,
  descricao = "Rancho para aluguel por temporada às margens da Represa de Miranda, em Indianópolis-MG, a ~1h de Uberlândia. Piscina aquecida, 10 suítes até 30 pessoas, quiosque, esportes e natureza.",
  imagem = "/og.jpg",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImagem = new URL(imagem, Astro.site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover: no iPhone a página desenha por baixo da barra de status
         e do "notch"; os elementos fixos usam env(safe-area-inset-*) pra não ficar embaixo. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Tipografia: Fraunces (títulos) + Inter (corpo) + Bebas Neue (só a marca),
         hospedadas no próprio site (ver global.css). Preload das duas principais. -->
    <link rel="preload" href={fonteTituloUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fonteCorpoUrl} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#2f5d3a" />
    <link rel="canonical" href={canonical} />

    <title>{titulo}</title>
    <meta name="description" content={descricao} />

    <!-- Open Graph (WhatsApp, Facebook, Instagram) -->
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagem} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content="Área de lazer do Rancho SPPA à beira da Represa de Miranda" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={ogImagem} />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="text-mata-escura antialiased">
    <slot />

    <footer class="bg-mata-escura py-12 text-center text-sm text-areia/70">
      {
        site.instagram && (
          <a
            href={site.instagram}
            target="_blank"
            rel="noopener"
            aria-label="@ranchopicapaumg no Instagram"
            class="mb-6 inline-flex items-center gap-2 rounded-full border border-areia/20 px-5 py-2 font-medium text-areia transition hover:border-dourado hover:text-dourado"
          >
            <Icon name="instagram" class="h-5 w-5" />
            @ranchopicapaumg
          </a>
        )
      }
      <nav class="mb-4 flex flex-wrap justify-center gap-x-6 gap-y-2">
        <a href="/" class="hover:text-areia">Início</a>
        <a href="/faq" class="hover:text-areia">Perguntas frequentes</a>
        <a href="/politicas" class="hover:text-areia">Políticas e regras</a>
      </nav>
      <p>{site.nomeCompleto} · {site.local}</p>
      <p class="mt-1">Desde 2001 · Aluguel por temporada</p>
    </footer>

    <WhatsAppFloat />
  </body>
</html>
