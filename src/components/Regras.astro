---
// Regras principais (escopo §4.5) — sem valores. Quem informa preço é a Lorena.
const regras = [
  {
    icone: "🗓️",
    titulo: "Diária por pessoa",
    texto: "O valor é informado pela nossa equipe no WhatsApp, conforme o período.",
  },
  {
    icone: "🌙",
    titulo: "Mínimo de 2 diárias",
    texto: "Para pernoite, a reserva é de no mínimo duas diárias.",
  },
  {
    icone: "💠",
    titulo: "Sinal de 50% via PIX",
    texto: "A data é garantida com um sinal de 50% por PIX; o restante na chegada.",
  },
  {
    icone: "🔑",
    titulo: "Caução na chegada",
    texto: "Um valor de caução é deixado na chegada e devolvido ao fim da estadia.",
  },
  {
    icone: "⏰",
    titulo: "Horários flexíveis",
    texto: "Permanência de 24 horas a partir da sua chegada. Som ambiente até 22h.",
  },
  {
    icone: "🐾",
    titulo: "Pets são bem-vindos",
    texto: "Com algumas regras: não subir nos móveis, necessidades fora das casas e sem entrar na piscina.",
  },
];
---

<section id="regras" class="bg-white/60 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <h2 class="font-titulo text-3xl font-bold text-mata sm:text-4xl">
        Regras principais
      </h2>
      <p class="mt-3 text-terra">
        O essencial para uma estadia tranquila. As regras completas de reserva e
        cancelamento a gente combina no WhatsApp.
      </p>
    </div>

    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        regras.map((r) => (
          <li class="flex gap-4 rounded-2xl bg-areia p-5 ring-1 ring-terra/10">
            <span class="text-2xl" aria-hidden="true">{r.icone}</span>
            <div>
              <h3 class="font-semibold text-mata">{r.titulo}</h3>
              <p class="mt-1 text-sm leading-relaxed text-terra">{r.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
