---
import site from "../data/site.json";
import avaliacoes from "../data/avaliacoes.json";
import Icon from "./Icon.astro";

const { resumo, lista } = avaliacoes;
const estrelas = [0, 1, 2, 3, 4];

// Avatar com a inicial + cor por pessoa (dá cara de gente sem precisar de foto).
const cores = ["bg-mata", "bg-agua", "bg-terra", "bg-mata-escura"];
const inicial = (nome: string) => nome.trim().charAt(0).toUpperCase();
const corDe = (nome: string) => {
  let s = 0;
  for (const c of nome) s += c.charCodeAt(0);
  return cores[s % cores.length];
};
---

<section id="avaliacoes" class="bg-areia py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <h2 class="font-titulo text-3xl font-bold text-mata sm:text-4xl">
        Quem já veio, ama
      </h2>
      <p class="mt-4 flex flex-wrap items-center justify-center gap-2 text-terra">
        <span class="text-2xl font-bold text-mata">{resumo.nota}</span>
        <span class="flex text-yellow-500" aria-hidden="true">
          {estrelas.map(() => <Icon name="star" class="h-5 w-5" />)}
        </span>
        <span>· {resumo.total} avaliações no {resumo.fonte}</span>
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        lista.map((a) => (
          <figure class="flex h-full flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-terra/10">
            <div class="mb-3 flex text-yellow-500" aria-label="5 de 5 estrelas">
              {estrelas.map(() => <Icon name="star" class="h-4 w-4" />)}
            </div>
            <blockquote class="flex-1 text-sm leading-relaxed text-mata-escura/80">
              “{a.texto}”
            </blockquote>
            <figcaption class="mt-4 flex items-center gap-3 border-t border-terra/10 pt-4">
              <span
                class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-full ${corDe(a.nome)} text-base font-bold text-areia`}
                aria-hidden="true"
              >
                {inicial(a.nome)}
              </span>
              <span class="min-w-0">
                <span class="block font-semibold text-mata">{a.nome}</span>
                <span class="flex items-center gap-1 text-xs text-terra/70">
                  <Icon name="star" class="h-3 w-3 text-yellow-500" />
                  {a.quando}
                </span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a
        href={site.mapsLink}
        target="_blank"
        rel="noopener"
        class="text-sm font-medium text-agua underline underline-offset-4 hover:text-mata"
      >
        Ver todas as avaliações no Google →
      </a>
    </div>
  </div>
</section>
