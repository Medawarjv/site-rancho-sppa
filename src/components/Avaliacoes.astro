---
import site from "../data/site.json";
import avaliacoes from "../data/avaliacoes.json";
import Icon from "./Icon.astro";

const { resumo, lista } = avaliacoes;
const estrelas = [0, 1, 2, 3, 4];

// Foto de perfil do Google por pessoa (com fallback para a inicial).
const fotos: Record<string, string> = {
  "Larissa Gomes Petrucci": "/avatars/larissa.png",
  "Marcos Marques": "/avatars/marcos.png",
  "Elizabelle Fezzani": "/avatars/elizabelle.png",
  "Denise Silva": "/avatars/denise.png",
  "Clayton Dias": "/avatars/clayton.png",
  "Debora Cruz": "/avatars/debora.png",
};

// Avatar com a inicial + cor por pessoa (fallback caso a foto não carregue).
const cores = ["bg-mata", "bg-agua", "bg-terra", "bg-mata-escura"];
const inicial = (nome: string) => nome.trim().charAt(0).toUpperCase();
const corDe = (nome: string) => {
  let s = 0;
  for (const c of nome) s += c.charCodeAt(0);
  return cores[s % cores.length];
};
---

<section id="avaliacoes" class="bg-areia py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-terra">
        Quem já veio
      </p>
      <h2 class="font-titulo text-3xl font-semibold text-mata-escura sm:text-4xl">
        Histórias de quem ama voltar
      </h2>
      <p class="mt-4 flex flex-wrap items-center justify-center gap-2 text-tinta/80">
        <span class="text-2xl font-semibold text-mel">{resumo.nota}</span>
        <span class="flex text-mel" aria-hidden="true">
          {estrelas.map(() => <Icon name="star" class="h-5 w-5" />)}
        </span>
        <span>· {resumo.total} avaliações no {resumo.fonte}</span>
      </p>
    </div>

    <!-- Celular: carrossel lateral com encaixe (o próximo cartão aparece na borda,
         convidando a arrastar). Do tablet pra cima, grade. -->
    <div
      class="-mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-6 px-6 pb-2 [scrollbar-width:none] sm:mx-0 sm:grid sm:snap-none sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-3 [&::-webkit-scrollbar]:hidden"
      aria-label="Avaliações de hóspedes"
    >
      {
        lista.map((a) => (
          <figure class="flex w-[85%] shrink-0 snap-start flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-terra/10 sm:h-full sm:w-auto">
            <div class="mb-3 flex text-mel" role="img" aria-label="5 de 5 estrelas">
              {estrelas.map(() => <Icon name="star" class="h-4 w-4" />)}
            </div>
            <blockquote class="flex-1 text-sm leading-relaxed text-mata-escura/80">
              “{a.texto}”
            </blockquote>
            <figcaption class="mt-4 flex items-center gap-3 border-t border-terra/10 pt-4">
              <span
                class={`relative flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full ${corDe(a.nome)} text-base font-bold text-areia`}
              >
                {inicial(a.nome)}
                {
                  fotos[a.nome] && (
                    <img
                      src={fotos[a.nome]}
                      alt={`Foto de ${a.nome}`}
                      class="absolute inset-0 h-full w-full object-cover"
                      loading="lazy"
                      onerror="this.remove()"
                    />
                  )
                }
              </span>
              <span class="min-w-0">
                <span class="block font-semibold text-mata">{a.nome}</span>
                <span class="flex items-center gap-1 text-xs text-terra/70">
                  <Icon name="star" class="h-3 w-3 text-mel" />
                  {a.quando}
                </span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="mt-3 text-center text-xs text-terra/70 sm:hidden" aria-hidden="true">
      Arraste para o lado para ver mais →
    </p>

    <div class="mt-8 text-center sm:mt-10">
      <a
        href={site.mapsLink}
        target="_blank"
        rel="noopener"
        class="text-sm font-medium text-agua underline underline-offset-4 hover:text-mata"
      >
        Ver todas as avaliações no Google →
      </a>
    </div>
  </div>
</section>
