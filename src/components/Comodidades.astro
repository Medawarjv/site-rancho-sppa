---
import { Image } from "astro:assets";
import site from "../data/site.json";
import Icon from "./Icon.astro";
import TituloSecao from "./TituloSecao.astro";
import bannerImg from "../assets/comodidades.jpg";

const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent("Olá! Quero montar minha estadia no Rancho SPPA (comodidades e/ou parceiros). Pode me ajudar?")}`;

// GRUPO 1 — o que já vem incluso na estadia (checklist).
// Só entra aqui o que o rancho realmente fornece. Roupa de cama e banho NÃO entra:
// é o hóspede quem leva (ver FAQ "O que está incluso e o que preciso levar?").
const comodidades = [
  { icone: "utensils", titulo: "Utensílios de cozinha", texto: "Panelas, louças e talheres para o grupo todo. É só trazer os ingredientes." },
  { icone: "flame", titulo: "Churrasqueira e forno a lenha", texto: "Do churrasco de domingo à pizza feita na hora, sem sair do quiosque." },
  { icone: "chef-hat", titulo: "Cozinha industrial", texto: "Espaço e equipamentos para cozinhar para muita gente, sem aperto." },
  { icone: "wine", titulo: "Taças, travessas e tábuas", texto: "Mesa bem servida, do brinde à tábua de frios." },
  { icone: "fridge", titulo: "Freezer, geladeira e cervejeira", texto: "Espaço de sobra para as compras do grupo e bebida sempre gelada." },
  { icone: "check", titulo: "Básico do dia a dia", texto: "Gás, água potável, papel higiênico, detergente, bucha e sacos de lixo já esperam por você." },
];

// GRUPO 2 — parceiros independentes indicados pelo rancho (curadoria).
const parceiros = [
  { icone: "cart", titulo: "Mercado e depósito de bebidas", texto: "Para abastecer a despensa e garantir as bebidas do grupo." },
  { icone: "croissant", titulo: "Padaria", texto: "Café da manhã prático e completo para o seu grupo." },
  { icone: "utensils", titulo: "Cozinheiro e churrasqueiro", texto: "Profissionais que preparam as refeições do seu grupo no próprio rancho." },
  { icone: "cake-slice", titulo: "Bolos e doces", texto: "Para aniversários e comemorações especiais." },
  { icone: "car", titulo: "Transporte", texto: "Para a chegada e o deslocamento do seu grupo." },
  { icone: "anchor", titulo: "Lancha e flutuante", texto: "Para aproveitar ainda mais a Represa de Miranda." },
];
---

<section id="comodidades" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <TituloSecao
      kicker="Monte sua experiência"
      titulo="Deixe sua estadia ainda mais completa"
      sub="Além de toda a estrutura, você conta com itens que trazem mais conforto e praticidade. Escolha o que combina com a sua estadia. O resto a gente organiza pelo WhatsApp."
    />

    <!-- GRUPO 1: Do rancho (checklist, acento dourado) -->
    <div class="rounded-2xl border-l-2 border-mel bg-areia/60 p-6 sm:p-8">
      <div class="mb-6 flex items-center gap-3">
        <span class="font-titulo text-2xl text-[#a3761c]">01</span>
        <div>
          <h3 class="font-titulo text-xl font-semibold text-mata-escura">
            Do <em>rancho</em>
          </h3>
          <p class="text-sm text-tinta/75">já incluso na sua estadia</p>
        </div>
      </div>
      <ul class="grid gap-x-8 gap-y-1 sm:grid-cols-2">
        {
          comodidades.map((c) => (
            <li class="group flex items-start gap-3 rounded-lg px-2 py-2.5 transition hover:bg-mel/5">
              <Icon name={c.icone} class="mt-0.5 h-5 w-5 shrink-0 text-mel" />
              <div>
                <span class="font-medium text-mata-escura">{c.titulo}</span>
                <p class="text-sm leading-relaxed text-tinta/75">{c.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 border-t border-terra/10 px-2 pt-4 text-sm text-tinta/70">
        Você deve levar alimentos, bebidas e roupas de cama e banho. Os travesseiros já são fornecidos pelo rancho.
      </p>
    </div>

    <!-- Divisor decorativo -->
    <div class="my-10 flex items-center justify-center gap-4 text-terra/25">
      <span class="h-px w-16 bg-current"></span>
      <Icon name="leaf" class="h-5 w-5 text-mel/70" />
      <span class="h-px w-16 bg-current"></span>
    </div>

    <!-- GRUPO 2: Serviços indicados (cards, acento verde) -->
    <div class="rounded-2xl border-l-2 border-mata bg-mata/[0.04] p-6 sm:p-8">
      <div class="mb-6 flex items-center gap-3">
        <span class="font-titulo text-2xl text-mata">02</span>
        <div>
          <h3 class="font-titulo text-xl font-semibold text-mata-escura">
            Serviços <em>indicados</em>
          </h3>
          <p class="text-sm text-tinta/75">contatos de confiança para completar a sua estadia</p>
        </div>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          parceiros.map((p) => (
            <li class="group relative rounded-2xl bg-white p-5 shadow-[0_2px_20px_-8px_rgba(120,90,40,0.25)] ring-1 ring-terra/10 transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_14px_30px_-12px_rgba(30,63,39,0.3)]">
              <span class="absolute right-3 top-3 rounded-full bg-mata/10 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-mata">
                indicado
              </span>
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-mata/10 text-mata transition group-hover:bg-mata group-hover:text-areia">
                <Icon name={p.icone} class="h-5 w-5" />
              </span>
              <h4 class="mt-3 font-semibold text-mata-escura">{p.titulo}</h4>
              <p class="mt-1 text-sm leading-relaxed text-tinta/75">{p.texto}</p>
            </li>
          ))
        }
      </ul>

      <!-- Observações em destaque: como funciona a contratação e a busca pelo caseiro -->
      <div class="mt-6 space-y-3 rounded-xl bg-white p-5 text-sm leading-relaxed text-tinta/85 ring-1 ring-mata/20">
        <p class="flex items-start gap-3">
          <Icon name="info" class="mt-0.5 h-5 w-5 shrink-0 text-mata" />
          <span>
            <strong class="font-semibold text-mata-escura">Você contrata direto com cada fornecedor.</strong>
            A disponibilidade e o pagamento são combinados com eles. Apenas indicamos
            contatos de confiança, sem vínculo direto com o rancho.
          </span>
        </p>
        <p class="flex items-start gap-3">
          <Icon name="car" class="mt-0.5 h-5 w-5 shrink-0 text-mata" />
          <span>
            <strong class="font-semibold text-mata-escura">O fornecedor não entrega no rancho?</strong>
            Você pode combinar a entrega com o nosso caseiro, mediante o pagamento de uma taxa.
          </span>
        </p>
        <p class="flex items-start gap-3">
          <Icon name="sparkles" class="mt-0.5 h-5 w-5 shrink-0 text-mata" />
          <span>
            <strong class="font-semibold text-mata-escura">Quer chegar com tudo pronto?</strong>
            Combine antes da viagem e, quando você chegar, já encontra tudo preparado e as bebidas geladas.
          </span>
        </p>
      </div>
    </div>

    <!-- Banner + CTA fechando a seção -->
    <div class="relative mt-10 overflow-hidden rounded-2xl shadow-[0_18px_40px_-18px_rgba(30,63,39,0.35)]">
      <Image
        src={bannerImg}
        alt="Área de estar aconchegante no quiosque do Rancho SPPA"
        class="h-64 w-full object-cover sm:h-72"
        widths={[768, 1280]}
        sizes="(min-width: 1088px) 1024px, 100vw"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-mata-escura/65"></div>
      <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center text-white">
        <p class="font-titulo text-xl font-medium drop-shadow sm:text-2xl">
          Conforto de casa, no meio da natureza.
        </p>
        <a
          href={waHref}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-zap px-7 py-3.5 font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-zap-escuro"
        >
          Montar minha estadia no WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
