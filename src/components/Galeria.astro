---
import { Image, getImage } from "astro:assets";

// Temas da galeria (ordem das abas).
const temas = [
  { id: "lazer", nome: "Áreas de lazer" },
  { id: "esportes", nome: "Jogos & quadras" },
  { id: "natureza", nome: "Natureza & represa" },
  { id: "quiosque", nome: "Quiosque & churrasqueira" },
  { id: "acomodacoes", nome: "Acomodações" },
];

// Legendas por tema/arquivo (aparecem no hover e no lightbox).
// O comentário indica a foto de origem: imagens/<pasta>/ no acervo antigo, ou
// fotografo/<id> no ensaio profissional de out/2026 (F = solo, D = drone).
const legendas: Record<string, string> = {
  "lazer/01.jpg": "Piscina com deck de pedra e mesas ao sol", // fotografo/F20
  "lazer/02.jpg": "Piscina entre coqueiros, ao lado do quiosque", // fotografo/F34
  "lazer/03.jpg": "Piscina menor, com a varanda de madeira ao fundo", // fotografo/F21
  "lazer/04.jpg": "Playground em grama sintética", // fotografo/F68
  "lazer/05.jpg": "Lounge coberto com sofás, de frente para a mata", // fotografo/F23
  "lazer/06.jpg": "Varanda com sofás e mesas rústicas de madeira", // fotografo/F33
  "lazer/07.jpg": "Sofás de vime no lounge, com a sinuca ao fundo", // fotografo/F71
  "lazer/08.jpg": "Vinho gelado no deck em fim de tarde", // lazer/Vinho.jpeg (recorte 960x720)
  "lazer/09.jpg": "Fogueira para as noites no rancho", // detalhes/IMG-20250817-WA0030
  "esportes/01.jpg": "Quadra de areia com playground e piscina ao lado", // fotografo/F17
  "esportes/02.jpg": "Quadra de areia para beach tennis, peteca e vôlei", // fotografo/F67
  "esportes/03.jpg": "Vista de cima: quadra de areia e playground", // fotografo/D07
  "esportes/04.jpg": "Campo de futebol gramado entre as palmeiras", // fotografo/F15
  "esportes/05.jpg": "Campo de futebol visto de cima", // fotografo/D06
  "esportes/06.jpg": "Mesa de sinuca no lounge coberto", // fotografo/F28
  "esportes/07.jpg": "Bicicleta ao pôr do sol, com a represa ao fundo", // lazer/WhatsApp 2026-09-18 13.19.04
  "natureza/01.jpg": "Amanhecer na Represa de Miranda, visto do alto", // fotografo/D09
  "natureza/02.jpg": "Vista aérea: 430 metros de margem na represa", // fotografo/D04
  "natureza/03.jpg": "Píer e tablado de pesca na represa", // fotografo/D08
  "natureza/04.jpg": "Cachoeira dentro da propriedade", // fotografo/F78
  "natureza/05.jpg": "Riacho com banco para descansar na mata", // fotografo/F76
  "natureza/06.jpg": "Horta em canteiros elevados", // fotografo/F05
  "natureza/07.jpg": "A cachoeira do rancho em aquarela, por Lilian Tibery", // natureza/Obra de lilian tibery (recorte sem a borda do papel)
  "natureza/08.jpg": "Seriema, visita frequente no rancho", // natureza/natureza.jpeg (recorte 960x800)
  "natureza/09.jpg": "Pôr do sol na represa", // represa/WhatsApp 2026-08-23 19.21.30
  "natureza/10.jpg": "Caiaque e stand-up na represa", // represa/WhatsApp 2026-08-23 19.17.54 (2)
  "natureza/11.jpg": "Flamboyant florido no rancho", // natureza/WhatsApp 2026-08-23 19.17.58
  "quiosque/01.jpg": "Quiosque com rede, mesas e sofás", // fotografo/F22
  "quiosque/02.jpg": "Salão com bar, mesas e churrasqueira", // fotografo/F25
  "quiosque/03.jpg": "Salão do quiosque, com dardos e TV", // fotografo/F66
  "quiosque/04.jpg": "Bar e churrasqueira de tijolinho", // fotografo/F29
  "quiosque/05.jpg": "Fogão a lenha e forno de pizza", // fotografo/F27
  "quiosque/06.jpg": "Mesas e sofás no quiosque coberto", // fotografo/F31
  "quiosque/07.jpg": "Cozinha industrial completa", // fotografo/F74
  "quiosque/08.jpg": "Quiosque iluminado à noite", // quiosque/WhatsApp 2026-08-23 19.18.01 (1)
  "acomodacoes/01.jpg": "Sede em madeira com varanda", // fotografo/F16
  "acomodacoes/02.jpg": "Chalé com varanda de madeira", // fotografo/F19
  "acomodacoes/03.jpg": "Varanda da sede ao entardecer", // fotografo/F60
  "acomodacoes/04.jpg": "Sala de estar do chalé", // fotografo/F58
  "acomodacoes/05.jpg": "Sala com mesa de refeições", // fotografo/F57
  "acomodacoes/06.jpg": "Suíte com cama de casal, TV e ar-condicionado", // fotografo/F47
  "acomodacoes/07.jpg": "Suíte com cama de casal e cama de solteiro", // fotografo/F42
  "acomodacoes/08.jpg": "Suíte com camas de solteiro", // fotografo/F50
  "acomodacoes/09.jpg": "Suíte com cama box", // fotografo/F54
  "acomodacoes/10.jpg": "Banheiro da suíte com box de vidro", // fotografo/F43
};

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/galeria/*/*.{jpg,jpeg,png}",
  { eager: true },
);

const fotos = await Promise.all(
  Object.entries(modules)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod]) => {
      const partes = path.split("/");
      const chave = partes.slice(-2).join("/"); // ex.: "lazer/01.jpg"
      const cat = partes[partes.length - 2];
      const cheia = await getImage({ src: mod.default, width: 1400, format: "webp" });
      return {
        thumb: mod.default,
        full: cheia.src,
        cat,
        alt: legendas[chave] ?? "Foto do Rancho Pica-Pau MG",
      };
    }),
);

const primeira = temas[0].id;
---

<section id="galeria" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto mb-8 max-w-2xl text-center">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-terra">
        Galeria
      </p>
      <h2 class="font-titulo text-3xl font-semibold text-mata-escura sm:text-4xl">
        Um passeio pelo rancho
      </h2>
      <p class="mt-4 leading-relaxed text-tinta/70">
        Explore por tema. Toque em qualquer foto para ampliar.
      </p>
    </div>

    <!-- Abas de tema -->
    <!-- No celular: uma faixa só, com rolagem lateral e bordas esmaecidas
         (antes as 5 abas quebravam em 4 linhas). No desktop, centralizadas. -->
    <div
      class="-mx-6 mb-8 flex gap-2 overflow-x-auto px-6 pb-1 [mask-image:linear-gradient(to_right,transparent,#000_1.5rem,#000_calc(100%-1.5rem),transparent)] [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:justify-center sm:overflow-visible sm:px-0 sm:[mask-image:none] [&::-webkit-scrollbar]:hidden"
      role="tablist"
    >
      {
        temas.map((t) => (
          <button
            type="button"
            role="tab"
            aria-controls="galeria-painel"
            class="galeria-tab shrink-0 whitespace-nowrap rounded-full border px-4 py-2 text-sm font-medium transition active:scale-[0.97]"
            data-tab={t.id}
          >
            {t.nome}
          </button>
        ))
      }
    </div>

    <!-- Grade -->
    <div id="galeria-painel" role="tabpanel" aria-label="Fotos do tema selecionado">
    <ul id="galeria-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4">
      {
        fotos.map((f, i) => (
          <li class="galeria-item" data-cat={f.cat}>
            <button
              type="button"
              class="group relative block w-full overflow-hidden rounded-xl ring-1 ring-terra/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-mata"
              data-full={f.full}
              data-index={i}
              data-legenda={f.alt}
              aria-label={`Ampliar: ${f.alt}`}
            >
              {/* alt vazio de propósito: o botão já descreve a foto (evita leitura duplicada) */}
              <Image
                src={f.thumb}
                alt=""
                class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105"
                widths={[320, 480, 640]}
                sizes="(min-width: 1088px) 340px, (min-width: 640px) 33vw, 50vw"
                loading="lazy"
              />
              <span class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-2 bg-gradient-to-t from-black/70 to-transparent p-3 text-left text-xs font-medium text-white opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100">
                {f.alt}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
    </div>
  </div>

  {/* Lightbox */}
  <div
    id="lightbox"
    class="fixed inset-0 z-[60] flex items-center justify-center bg-black/90 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Foto ampliada"
  >
    <button id="lb-fechar" type="button" aria-label="Fechar"
      class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full bg-white/15 text-2xl text-white hover:bg-white/25">✕</button>
    <button id="lb-ant" type="button" aria-label="Foto anterior"
      class="absolute left-2 flex h-12 w-12 items-center justify-center rounded-full bg-white/15 text-3xl text-white hover:bg-white/25 sm:left-6">‹</button>
    <img id="lb-img" src="" alt="" class="max-h-[85vh] max-w-full rounded-lg object-contain" />
    <button id="lb-prox" type="button" aria-label="Próxima foto"
      class="absolute right-2 flex h-12 w-12 items-center justify-center rounded-full bg-white/15 text-3xl text-white hover:bg-white/25 sm:right-6">›</button>
    <div class="absolute bottom-4 left-0 right-0 px-6 text-center text-white/90">
      <p id="lb-legenda" class="text-sm font-medium drop-shadow"></p>
      <p id="lb-contador" class="mt-1 text-xs text-white/60"></p>
    </div>
  </div>
</section>

<style>
  /* Lightbox: entra com fade + leve crescimento da foto (ease-out, 220 ms) e sai
     mais rápido (150 ms). Quem pede menos movimento não ganha transição. */
  #lightbox {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 150ms ease-in,
      visibility 0s linear 150ms;
  }
  #lightbox[data-aberto] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 220ms cubic-bezier(0.23, 1, 0.32, 1),
      visibility 0s;
  }
  #lb-img {
    transform: scale(0.96);
    transition: transform 150ms ease-in;
  }
  #lightbox[data-aberto] #lb-img {
    transform: scale(1);
    transition: transform 260ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    #lightbox,
    #lightbox[data-aberto],
    #lb-img,
    #lightbox[data-aberto] #lb-img {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const grid = document.getElementById("galeria-grid")!;
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".galeria-tab"));
  const itens = Array.from(document.querySelectorAll<HTMLLIElement>(".galeria-item"));
  const lb = document.getElementById("lightbox");
  const lbImg = document.getElementById("lb-img") as HTMLImageElement;
  const contador = document.getElementById("lb-contador");
  const legenda = document.getElementById("lb-legenda");

  const ativoOn = "bg-mata text-white border-mata";
  const ativoOff = "border-terra/25 text-terra hover:border-mata/40";

  let visiveis: HTMLButtonElement[] = [];
  let atual = 0;

  // Carrega as fotos da aba ativa na hora (não depende de lazy/observer, que
  // não dispara de forma confiável para itens que começam escondidos).
  function carregarVisiveis() {
    visiveis.forEach((b) => {
      const img = b.querySelector("img");
      if (img && !img.complete) {
        const src = img.getAttribute("src") || img.src;
        img.loading = "eager";
        img.removeAttribute("src");
        img.src = src;
      }
    });
  }

  function selecionarTab(id: string) {
    tabs.forEach((t) => {
      const on = t.dataset.tab === id;
      t.className = "galeria-tab shrink-0 whitespace-nowrap rounded-full border px-4 py-2 text-sm font-medium transition active:scale-[0.97] " + (on ? ativoOn : ativoOff);
      t.setAttribute("aria-selected", on ? "true" : "false");
    });
    itens.forEach((li) => {
      li.classList.toggle("hidden", li.dataset.cat !== id);
    });
    visiveis = itens
      .filter((li) => li.dataset.cat === id)
      .map((li) => li.querySelector<HTMLButtonElement>("button[data-full]")!);
    visiveis.forEach((b, i) => (b.dataset.pos = String(i)));
    carregarVisiveis();
  }

  const aberto = () => !!lb?.hasAttribute("data-aberto");
  const preCarregar = (i: number) => {
    const b = visiveis[(i + visiveis.length) % visiveis.length];
    if (b) new Image().src = b.dataset.full!;
  };

  // Troca foto, legenda e contador juntos, só quando a foto nova já está pronta
  // (antes a legenda mudava e a foto antiga ficava na tela até a nova carregar).
  function mostrar(i: number) {
    atual = (i + visiveis.length) % visiveis.length;
    const pedido = atual;
    const b = visiveis[atual];
    const src = b.dataset.full!;
    const alt = b.dataset.legenda ?? "";
    const aplicar = () => {
      if (pedido !== atual) return; // a pessoa já passou para outra foto
      lbImg.src = src;
      lbImg.alt = alt;
      if (legenda) legenda.textContent = alt;
      if (contador) contador.textContent = `${atual + 1} / ${visiveis.length}`;
    };
    const pre = new Image();
    pre.src = src;
    pre.decode().then(aplicar, aplicar);
    preCarregar(atual + 1);
    preCarregar(atual - 1);
  }

  let focoAntes: HTMLElement | null = null;
  function abrir(i: number) {
    focoAntes = document.activeElement as HTMLElement | null;
    lbImg.removeAttribute("src"); // não mostra a última foto da vez anterior
    if (legenda) legenda.textContent = "";
    if (contador) contador.textContent = "";
    mostrar(i);
    lb?.setAttribute("data-aberto", "");
    document.body.style.overflow = "hidden";
    document.getElementById("lb-fechar")?.focus({ preventScroll: true });
  }
  function fechar() {
    lb?.removeAttribute("data-aberto");
    document.body.style.overflow = "";
    // devolve o foco à foto da grade correspondente à que estava aberta
    (visiveis[atual] ?? focoAntes)?.focus({ preventScroll: true });
  }

  tabs.forEach((t) =>
    t.addEventListener("click", () => {
      selecionarTab(t.dataset.tab!);
      // no celular, traz a aba escolhida para dentro da faixa
      t.scrollIntoView({ inline: "nearest", block: "nearest", behavior: "smooth" });
    }),
  );
  grid.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-full]");
    if (btn && btn.dataset.pos !== undefined) abrir(Number(btn.dataset.pos));
  });
  document.getElementById("lb-fechar")?.addEventListener("click", fechar);
  document.getElementById("lb-prox")?.addEventListener("click", () => mostrar(atual + 1));
  document.getElementById("lb-ant")?.addEventListener("click", () => mostrar(atual - 1));
  lb?.addEventListener("click", (e) => {
    if (e.target === lb) fechar();
  });
  document.addEventListener("keydown", (e) => {
    if (!aberto()) return;
    if (e.key === "Escape") fechar();
    if (e.key === "ArrowRight") mostrar(atual + 1);
    if (e.key === "ArrowLeft") mostrar(atual - 1);
  });
  let x0: number | null = null;
  lb?.addEventListener("touchstart", (e) => (x0 = e.touches[0].clientX), { passive: true });
  lb?.addEventListener("touchend", (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) mostrar(atual + (dx < 0 ? 1 : -1));
    x0 = null;
  });

  // começa na primeira aba
  selecionarTab(tabs[0].dataset.tab!);
</script>
