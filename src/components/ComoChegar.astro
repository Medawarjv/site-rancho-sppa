---
import site from "../data/site.json";
import Icon from "./Icon.astro";
import TituloSecao from "./TituloSecao.astro";

// Mapa embutido (sem chave de API) apontando pro pin exato do rancho.
const embedSrc = `https://maps.google.com/maps?q=${site.mapsLat},${site.mapsLng}(${encodeURIComponent(site.nome)})&z=13&output=embed`;
---

<section id="como-chegar" class="bg-areia py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-6">
  <TituloSecao kicker="A localização" titulo="Como chegar" sub={site.endereco} />

  <div class="grid items-center gap-8 lg:grid-cols-2">
    <!-- Mapa -->
    <div class="overflow-hidden rounded-2xl shadow-md ring-1 ring-terra/10">
      <iframe
        src={embedSrc}
        title={`Mapa da localização do ${site.nome}`}
        class="h-72 w-full border-0 sm:h-96"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>

    <!-- Texto do caminho -->
    <div>
      <p class="text-lg leading-relaxed text-terra">
        Estamos a cerca de <strong class="text-mata">1 hora de Uberlândia</strong>,
        às margens da Represa de Miranda.
      </p>
      <ul class="mt-6 space-y-3 text-terra">
        <li class="flex gap-3">
          <Icon name="route" class="mt-0.5 h-5 w-5 shrink-0 text-mata" />
          <span>O caminho é pela <strong>BR-365</strong>, passando por Indianópolis-MG.</span>
        </li>
        <li class="flex gap-3">
          <Icon name="mountain" class="mt-0.5 h-5 w-5 shrink-0 text-mata" />
          <span>Os últimos <strong>~4,5 km são de estrada de terra</strong> até o rancho.</span>
        </li>
        <li class="flex gap-3">
          <Icon name="map-pin" class="mt-0.5 h-5 w-5 shrink-0 text-mata" />
          <span>{site.endereco}</span>
        </li>
      </ul>

      <a
        href={site.mapsLink}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-mata px-7 py-3 font-semibold text-areia shadow-md transition hover:scale-105"
      >
        <Icon name="map-pin" class="h-5 w-5" />
        Abrir rota no Google Maps
      </a>
    </div>
  </div>
  </div>
</section>
